{
  "name": "predator-news-markdown",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:data": "node scripts/data/validate-data.mjs",
    "validate:ingestion": "node scripts/ingestion/validate-schemas.mjs",
    "simulate:ingestion": "node scripts/ingestion/run-simulated.mjs",
    "simulate:review": "node scripts/ingestion/run-simulated-review.mjs",
    "prepare:wave1-review": "node scripts/ingestion/prepare-wave1-human-review.mjs",
    "validate:wave1-review": "node scripts/ingestion/validate-wave1-human-review.mjs",
    "apply:wave1-human-approval": "node scripts/ingestion/apply-wave1-human-approval.mjs",
    "simulate:promotion": "node scripts/ingestion/run-simulated-promotion.mjs",
    "simulate:readiness": "node scripts/ingestion/run-dataset-002-dry-run.mjs",
    "simulate:controlled-promotion": "node scripts/ingestion/run-controlled-promotion.mjs",
    "search:official": "node scripts/ingestion/search-official.mjs",
    "ingest:official": "node scripts/ingestion/publish-official-tjdft.mjs && node scripts/data/enrich-official-tjdft.mjs",
    "test": "node scripts/test.mjs",
    "build": "npm run validate:data && node scripts/build.mjs && node scripts/validate-build-links.mjs",
    "check:release": "npm run build && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  }
}
