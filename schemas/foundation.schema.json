{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predator.news/schemas/foundation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "titulo", "formulacao", "temas", "produtos", "status"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "titulo": {"type": "string", "minLength": 5},
    "formulacao": {"type": "string", "minLength": 20},
    "temas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "produtos": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "base_normativa": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "frase_peca": {"type": "string", "minLength": 20},
    "status": {"type": "string"}
  }
}
